  "IDs": "JC01000_003",
  "AreaName": "公会",
  "Difficulty": 0,
  "Type": "引导",
  "SpeakingRole": "S13101,0,公会管家",
  "Content": "其他管理员因为没事情干都亲自去冒险了，我们现在去把她们找回来吧！",
  "ContentI2": "Newbee/Plot_Desc_03"
 },
 {
