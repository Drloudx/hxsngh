 },
 {
  "Id": "theater_2",
  "IDs": "JC01000_002",
  "AreaName": "公会",
  "Difficulty": 0,
  "Type": "引导",
  "SpeakingRole": "S13101,0,公会管家",
  "Content": "因为长时间没有人组织冒险，公会的资金已经所剩不多了，现在只剩我和几个饿肚子的笨蛋……",
  "ContentI2": "Newbee/Plot_Desc_02"
 },
 {
